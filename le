#!/bin/bash
# sector_coherence.sh - Handle multi-level sector expertise

assess_sector_gaps() {
    local student_id=$1
    local target_level=$2
    
    # When Level 2 arts is weak but Level 3 computing is strong
    if [[ $(get_level "arts" $student_id) -lt 2 ]] && \
       [[ $(get_level "computing" $student_id) -eq 3 ]]; then
        
        # Trigger tailored support, NOT grants
        echo "SUPPORT_TYPE: bursary"
        echo "SUPPORT_TYPE: loans"
        echo "SUPPORT_REASON: Level 2 sector gap requires foundation support"
        
        # Grants only for Level 3+ projects
        if [[ $target_level -ge 3 ]]; then
            echo "GRANT_ELIGIBLE: true"
            echo "GRANT_SCOPE: project_specific"
        fi
    fi
}
